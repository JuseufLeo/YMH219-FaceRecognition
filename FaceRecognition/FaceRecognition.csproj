<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>FaceRecognition</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenCV'nin C# sarmalayıcısı (yüz modülü dahil) -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <!-- OpenCV'nin Windows için yerel kütüphaneleri -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <!-- Mat <-> Bitmap dönüşümü (PictureBox'ta göstermek için) -->
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yüz algılama için OpenCV'nin hazır Haar Cascade modeli -->
    <None Include="Data\haarcascade_frontalface_default.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
